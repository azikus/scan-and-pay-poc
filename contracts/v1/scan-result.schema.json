{
  "$defs": {
    "Alternative": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "value",
        "reason"
      ],
      "title": "Alternative",
      "type": "object"
    },
    "Amount": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "$ref": "#/$defs/Observation"
        },
        "currency": {
          "$ref": "#/$defs/Observation"
        },
        "role": {
          "default": "unknown",
          "enum": [
            "amount_due",
            "invoice_total",
            "instalment",
            "other",
            "unknown"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "title": "Amount",
      "type": "object"
    },
    "BillerDestination": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "biller_reference",
          "default": "biller_reference",
          "title": "Kind",
          "type": "string"
        },
        "scheme": {
          "$ref": "#/$defs/Observation"
        },
        "biller_code": {
          "$ref": "#/$defs/Observation"
        },
        "notice_number": {
          "$ref": "#/$defs/Observation"
        },
        "creditor_tax_code": {
          "$ref": "#/$defs/Observation"
        },
        "bill_reference": {
          "$ref": "#/$defs/Observation"
        }
      },
      "title": "BillerDestination",
      "type": "object"
    },
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "option_label": {
          "$ref": "#/$defs/Observation"
        },
        "due_date": {
          "$ref": "#/$defs/Observation"
        },
        "payment_condition": {
          "$ref": "#/$defs/Observation"
        },
        "account_country": {
          "$ref": "#/$defs/Observation"
        },
        "beneficiary_name": {
          "$ref": "#/$defs/Observation"
        },
        "account_holder_name": {
          "$ref": "#/$defs/Observation"
        },
        "amount": {
          "$ref": "#/$defs/Amount"
        },
        "destination": {
          "discriminator": {
            "mapping": {
              "biller_reference": "#/$defs/BillerDestination",
              "iban": "#/$defs/IBANDestination",
              "uk_domestic": "#/$defs/UKDestination",
              "unresolved": "#/$defs/UnresolvedDestination"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/UKDestination"
            },
            {
              "$ref": "#/$defs/IBANDestination"
            },
            {
              "$ref": "#/$defs/BillerDestination"
            },
            {
              "$ref": "#/$defs/UnresolvedDestination"
            }
          ],
          "title": "Destination"
        },
        "remittance": {
          "$ref": "#/$defs/Remittance"
        }
      },
      "required": [
        "id",
        "destination"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "CandidateGuidance": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "route": {
          "title": "Route",
          "type": "string"
        },
        "supported_draft": {
          "default": false,
          "title": "Supported Draft",
          "type": "boolean"
        },
        "payment_channels": {
          "items": {
            "type": "string"
          },
          "title": "Payment Channels",
          "type": "array"
        },
        "payment_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payment Note"
        },
        "account_country": {
          "$ref": "#/$defs/ContextHint"
        },
        "fields": {
          "additionalProperties": {
            "$ref": "#/$defs/FieldRule"
          },
          "title": "Fields",
          "type": "object"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/Reason"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "candidate_id",
        "route",
        "account_country",
        "fields"
      ],
      "title": "CandidateGuidance",
      "type": "object"
    },
    "ContextHint": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "status": {
          "default": "unknown",
          "enum": [
            "observed",
            "inferred",
            "derived",
            "unknown",
            "ambiguous"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "excerpts": {
          "items": {
            "type": "string"
          },
          "title": "Excerpts",
          "type": "array"
        }
      },
      "required": [
        "reason"
      ],
      "title": "ContextHint",
      "type": "object"
    },
    "Cost": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "default": "unknown",
          "enum": [
            "reported",
            "estimated",
            "unknown",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        },
        "amount": {
          "anyOf": [
            {
              "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount"
        },
        "currency": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "pricing_source": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pricing Source"
        },
        "priced_at": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Priced At"
        }
      },
      "title": "Cost",
      "type": "object"
    },
    "Diagnostics": {
      "additionalProperties": false,
      "properties": {
        "requested_model": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requested Model"
        },
        "returned_model": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Returned Model"
        },
        "versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Versions",
          "type": "object"
        },
        "timings_ms": {
          "$ref": "#/$defs/Timings"
        },
        "validation": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Validation",
          "type": "array"
        },
        "routing": {
          "$ref": "#/$defs/Routing"
        },
        "stages": {
          "items": {
            "$ref": "#/$defs/Stage"
          },
          "title": "Stages",
          "type": "array"
        },
        "context_explanations": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Context Explanations",
          "type": "object"
        }
      },
      "title": "Diagnostics",
      "type": "object"
    },
    "DocumentContext": {
      "additionalProperties": false,
      "properties": {
        "language": {
          "$ref": "#/$defs/Observation"
        },
        "issuer_country": {
          "$ref": "#/$defs/Observation"
        }
      },
      "title": "DocumentContext",
      "type": "object"
    },
    "Error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "details": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Details",
          "type": "object"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Error",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "image_id": {
          "minLength": 1,
          "title": "Image Id",
          "type": "string"
        },
        "excerpt": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excerpt"
        },
        "bbox": {
          "anyOf": [
            {
              "items": {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              "maxItems": 4,
              "minItems": 4,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        },
        "grounding": {
          "enum": [
            "ocr_span",
            "barcode_payload",
            "model_claim",
            "synthetic_fixture"
          ],
          "title": "Grounding",
          "type": "string"
        },
        "source_stage_id": {
          "minLength": 1,
          "title": "Source Stage Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "image_id",
        "grounding",
        "source_stage_id"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ExcludedProfile": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "id",
        "reason"
      ],
      "title": "ExcludedProfile",
      "type": "object"
    },
    "FieldRule": {
      "additionalProperties": false,
      "properties": {
        "requirement": {
          "enum": [
            "required",
            "optional",
            "not_applicable",
            "unresolved"
          ],
          "title": "Requirement",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "requirement",
        "reason"
      ],
      "title": "FieldRule",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "path": {
          "pattern": "^/",
          "title": "Path",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "not_checked",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "code",
        "path",
        "message",
        "status"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Hints": {
      "additionalProperties": false,
      "properties": {
        "language": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "issuer_country": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issuer Country"
        }
      },
      "title": "Hints",
      "type": "object"
    },
    "IBANDestination": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "iban",
          "default": "iban",
          "title": "Kind",
          "type": "string"
        },
        "iban": {
          "$ref": "#/$defs/Observation"
        },
        "bic": {
          "$ref": "#/$defs/Observation"
        }
      },
      "title": "IBANDestination",
      "type": "object"
    },
    "ImageInput": {
      "additionalProperties": false,
      "properties": {
        "image_id": {
          "minLength": 1,
          "title": "Image Id",
          "type": "string"
        },
        "original_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Original Sha256",
          "type": "string"
        },
        "canonical_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Canonical Sha256",
          "type": "string"
        },
        "width": {
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "mime_type": {
          "enum": [
            "image/jpeg",
            "image/png"
          ],
          "title": "Mime Type",
          "type": "string"
        },
        "hints": {
          "$ref": "#/$defs/Hints"
        }
      },
      "required": [
        "image_id",
        "original_sha256",
        "canonical_sha256",
        "width",
        "height",
        "mime_type"
      ],
      "title": "ImageInput",
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "raw_text": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Text"
        },
        "state": {
          "default": "missing",
          "enum": [
            "observed",
            "missing",
            "unreadable",
            "ambiguous",
            "inferred",
            "unsupported"
          ],
          "title": "State",
          "type": "string"
        },
        "origin": {
          "default": "document",
          "enum": [
            "document",
            "barcode",
            "caller_hint",
            "derived"
          ],
          "title": "Origin",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "normalization": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Normalization",
          "type": "array"
        },
        "alternatives": {
          "items": {
            "$ref": "#/$defs/Alternative"
          },
          "maxItems": 8,
          "title": "Alternatives",
          "type": "array"
        }
      },
      "title": "Observation",
      "type": "object"
    },
    "Payment": {
      "additionalProperties": false,
      "properties": {
        "document_context": {
          "$ref": "#/$defs/DocumentContext"
        },
        "supplier_name": {
          "$ref": "#/$defs/Observation"
        },
        "invoice_number": {
          "$ref": "#/$defs/Observation"
        },
        "customer_number": {
          "$ref": "#/$defs/Observation"
        },
        "description": {
          "$ref": "#/$defs/Observation"
        },
        "due_date": {
          "$ref": "#/$defs/Observation"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/Candidate"
          },
          "title": "Candidates",
          "type": "array"
        },
        "selected_candidate_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Candidate Id"
        },
        "review": {
          "$ref": "#/$defs/Review"
        }
      },
      "title": "Payment",
      "type": "object"
    },
    "ProfileRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "ProfileRef",
      "type": "object"
    },
    "Reason": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "path": {
          "pattern": "^/",
          "title": "Path",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "path",
        "message"
      ],
      "title": "Reason",
      "type": "object"
    },
    "Remittance": {
      "additionalProperties": false,
      "properties": {
        "reference": {
          "$ref": "#/$defs/Observation"
        },
        "model": {
          "$ref": "#/$defs/Observation"
        },
        "purpose_code": {
          "$ref": "#/$defs/Observation"
        },
        "reference_requirement": {
          "default": "unknown",
          "enum": [
            "required",
            "not_stated",
            "unknown"
          ],
          "title": "Reference Requirement",
          "type": "string"
        }
      },
      "title": "Remittance",
      "type": "object"
    },
    "Rendition": {
      "additionalProperties": false,
      "properties": {
        "image_id": {
          "minLength": 1,
          "title": "Image Id",
          "type": "string"
        },
        "width": {
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "transform": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Transform",
          "type": "array"
        }
      },
      "required": [
        "image_id",
        "width",
        "height"
      ],
      "title": "Rendition",
      "type": "object"
    },
    "Review": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "default": "insufficient_data",
          "enum": [
            "ready_for_review",
            "needs_review",
            "insufficient_data"
          ],
          "title": "State",
          "type": "string"
        },
        "user_confirmation_required": {
          "const": true,
          "default": true,
          "title": "User Confirmation Required",
          "type": "boolean"
        },
        "reasons": {
          "items": {
            "$ref": "#/$defs/Reason"
          },
          "title": "Reasons",
          "type": "array"
        }
      },
      "title": "Review",
      "type": "object"
    },
    "ReviewGuidance": {
      "additionalProperties": false,
      "properties": {
        "policy_version": {
          "default": "invoice-fields@4",
          "enum": [
            "invoice-fields@1",
            "invoice-fields@2",
            "invoice-fields@3",
            "invoice-fields@4"
          ],
          "title": "Policy Version",
          "type": "string"
        },
        "review_summary": {
          "default": "Review the printed payment details.",
          "title": "Review Summary",
          "type": "string"
        },
        "issuer_country": {
          "$ref": "#/$defs/ContextHint"
        },
        "language": {
          "$ref": "#/$defs/ContextHint"
        },
        "document_fields": {
          "additionalProperties": {
            "$ref": "#/$defs/FieldRule"
          },
          "title": "Document Fields",
          "type": "object"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/CandidateGuidance"
          },
          "title": "Candidates",
          "type": "array"
        }
      },
      "required": [
        "issuer_country",
        "language",
        "document_fields",
        "candidates"
      ],
      "title": "ReviewGuidance",
      "type": "object"
    },
    "Routing": {
      "additionalProperties": false,
      "properties": {
        "applied_rule_packs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Applied Rule Packs",
          "type": "array"
        },
        "reasons": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        }
      },
      "title": "Routing",
      "type": "object"
    },
    "Run": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "profile_id": {
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "profile_version": {
