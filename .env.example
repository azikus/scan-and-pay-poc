# Credentials and connection settings. Keep real values in .env only.

# Backend
SCANPAY_TOKEN=REPLACE_WITH_RANDOM_LOCAL_TOKEN
SCANPAY_DATA_DIR=.local/backend
SCANPAY_PROFILES_FILE=.local/providers.json

# LLM providers
OPENAI_API_KEY=
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=

# Azure Document Intelligence
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=

# Google Document AI
# Optional credential-file path; omit when using local Application Default Credentials.
# GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_DOCUMENTAI_LOCATION=
GOOGLE_DOCUMENTAI_OCR_PROCESSOR_ID=
GOOGLE_DOCUMENTAI_INVOICE_PROCESSOR_ID=

# AWS Textract
AWS_PROFILE=
AWS_REGION=

# Nanonets
NANONETS_API_KEY=
NANONETS_MODEL_OR_WORKFLOW_ID=

# Mindee
MINDEE_V2_API_KEY=
MINDEE_MODEL_ID=
