# Credentials and connection settings. Keep real values in .env only.

# Backend
SCANPAY_TOKEN=REPLACE_WITH_RANDOM_LOCAL_TOKEN
SCANPAY_DATA_DIR=.local/backend
SCANPAY_PROFILES_FILE=.local/providers.json

# LLM providers
OPENAI_API_KEY=
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=

# Azure Document Intelligence
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=

# Google Document AI
# Inline authorized-user or service-account JSON; overrides legacy ADC/file lookup.
GOOGLE_CREDENTIALS_JSON=
# Optional legacy credential-file path; omit when using inline JSON or local ADC.
# GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_DOCUMENTAI_LOCATION=
GOOGLE_DOCUMENTAI_OCR_PROCESSOR_ID=
GOOGLE_DOCUMENTAI_INVOICE_PROCESSOR_ID=

# AWS Textract
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary keys; leave blank for a long-lived IAM key pair.
AWS_SESSION_TOKEN=
# Optional legacy profile, ignored when an explicit key pair is configured.
AWS_PROFILE=
AWS_REGION=


# Mindee
MINDEE_V2_API_KEY=
MINDEE_MODEL_ID=
